# Maps JavaScript API (브라우저 로드용 — NEXT_PUBLIC_ 필요)
# Maps Platform → APIs → Maps JavaScript API 활성화
# Keys: ASCII only (A-Za-z0-9_-). No Korean labels, smart quotes, or UTF-8 BOM on the line (causes ByteString / fetch header errors).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 선택 — Cloud Console에서 Vector Map ID 생성 시 고급 마커 등에 사용 (없으면 DEMO_MAP_ID)
# NEXT_PUBLIC_GOOGLE_MAP_ID=

# 선택 — 특정 placeId 가중치(JSON). 비우면 무시
# NEXT_PUBLIC_PROMOTED_PLACES=

# 동일 키 또는 서버 전용 키 — 식당 목록은 Places Text Search (New) 사용
# Maps JavaScript API만 켜두면 지도만 되고 목록은 403 → 라이브러리에서 "Places API (New)" 활성화 + 결제 계정
# 사진은 /api/places/photo 가 서버에서 이 키로 받아오므로, 브라우저 키에만 "HTTP 리퍼러" 제한이 있어도 동작하려면 여기(서버 키)는 Places Photo·Places API 허용·IP 제한 없음 등으로 맞추는 것이 안전합니다.
GOOGLE_MAPS_API_KEY=

# IP 기반 대략 위치 (/api/geolocation) — 비우면 GOOGLE_MAPS_API_KEY와 동일하게 사용
# Maps Platform → 라이브러리에서 "Geolocation API" 활성화
GOOGLE_GEOLOCATION_API_KEY=

# 첫 추천 카드 AI 리뷰 요약 (Gemini) — 비우면 요약만 생략
GEMINI_API_KEY=
# 선택. 기본 gemini-2.0-flash (예: gemini-1.5-flash)
# GEMINI_MODEL=
